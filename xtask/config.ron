(
    schema_version: 1,
    package: (
        name: "ph-surfaces",
        version: "0.1.0",
        manifest: (
            publish: "[\"crates-io\"]",
            license: "MIT",
            edition: "2024",
            rust_version: "1.94.0",
            dependencies: [],
        ),
        files: [
            ".cargo_vcs_info.json",
            "Cargo.lock",
            "Cargo.toml",
            "Cargo.toml.orig",
            "LICENSE",
            "README.md",
            "examples/fail_safe_boundaries.rs",
            "examples/firmware_cost_budget.rs",
            "examples/firmware_quickstart.rs",
            "examples/mixed_calibration_map.rs",
            "examples/uniform_sensor_compensation.rs",
            "src/axis/binary.rs",
            "src/axis/bucketed.rs",
            "src/axis/linear.rs",
            "src/axis/mod.rs",
            "src/axis/uniform.rs",
            "src/boundary.rs",
            "src/error.rs",
            "src/evaluate.rs",
            "src/interp.rs",
            "src/lib.rs",
            "src/lookup.rs",
            "src/surface.rs",
        ],
        non_consumer_prefixes: [
            "AGENTS.md",
            "CHANGELOG.md",
            "clippy.toml",
            "deny.toml",
            "rust-toolchain.toml",
            "tools/",
            "docs/",
            "tests/",
            ".github/",
        ],
    ),
    examples: [
        "firmware_quickstart",
        "uniform_sensor_compensation",
        "mixed_calibration_map",
        "fail_safe_boundaries",
        "firmware_cost_budget",
    ],
    source_policy: (
        runtime_roots: ["crates/surfaces/src"],
        oracle_roots: ["crates/surfaces/src", "crates/surfaces/tests", "crates/surfaces/examples"],
        example_roots: ["crates/surfaces/examples"],
        arithmetic_kernel: "crates/surfaces/src/interp.rs",
        forbidden_example_types: ["Vec", "String", "Box", "Rc", "Arc"],
        forbidden_example_macros: ["vec", "print", "println", "eprint", "eprintln", "dbg"],
        dependency_manifests: ["Cargo.toml", "crates/surfaces/Cargo.toml", "crates/surfaces-bake/Cargo.toml", ".cargo/config.toml", ".cargo/config"],
    ),
    baker: (
        src: "crates/surfaces-bake/src",
        max_implementation_lines: 1600,
        generated: "crates/surfaces-bake/generated/rounding.rs",
        files: [
            ".cargo_vcs_info.json",
            "Cargo.lock",
            "Cargo.toml",
            "Cargo.toml.orig",
            "LICENSE",
            "README.md",
            "src/bound.rs",
            "src/emit.rs",
            "src/error.rs",
            "src/grid.rs",
            "src/lib.rs",
            "src/main.rs",
            "src/quantize.rs",
            "src/samples.rs",
        ],
    ),
    targets: [
        (id: "thumb", triple: "thumbv7em-none-eabi", asm_snapshot: "docs/asm-snapshot-thumbv7em-none-eabi.txt"),
        (id: "riscv", triple: "riscv32imac-unknown-none-elf", asm_snapshot: "docs/asm-snapshot-riscv32imac-unknown-none-elf.txt"),
    ],
    code_size: (
        snapshot: "docs/code-size-snapshot.txt",
        kernel_symbol: "ph_interp_kernel",
        kernel_path_fragment: "ph_surfaces::interp",
        kernel_mangled_fragment: "ph_surfaces6interp",
        pairings: [
            (symbol: "ph_eval_binary", feature: "pairing-binary", description: "Binary×Binary ELEVATION 5×4"),
            (symbol: "ph_eval_linear", feature: "pairing-linear", description: "Linear×Linear 3×2"),
            (symbol: "ph_eval_mixed", feature: "pairing-mixed", description: "BucketedAxis<17, 8> × UniformAxis<9, 0, 200>"),
            (symbol: "ph_eval_uniform", feature: "pairing-uniform", description: "Uniform×Uniform 2×2"),
        ],
    ),
    checks: [
        (name: "line endings", profiles: [Dev, Full, Release], action: LineEndings),
        (name: "no_std unconditional", profiles: [Dev, Full, Release], action: NoStdUnconditional),
        (name: "integer only", profiles: [Dev, Full, Release], action: IntegerOnly),
        (name: "no ph-curves", profiles: [Dev, Full, Release], action: NoPhCurves),
        (name: "baker line budget", profiles: [Dev, Full, Release], action: BakeLineBudget),
        (name: "baker package", profiles: [Full, Release], action: BakePackage),
        (name: "generated source", profiles: [Dev, Full, Release], action: GeneratedSource),
        (name: "manifest floor", profiles: [Dev, Full, Release], action: ManifestFloor),
        (name: "publish lock", profiles: [Dev, Full, Release], action: PublishLock),
        (name: "fmt", profiles: [Dev, Full, Release], action: Fmt),
        (name: "test", profiles: [Dev, Full, Release], action: Test),
        (name: "release test", profiles: [Full, Release], action: ReleaseTest),
        (name: "examples", profiles: [Full, Release], action: Examples),
        (name: "clippy", profiles: [Dev, Full, Release], action: Clippy),
        (name: "doc", profiles: [Full, Release], action: Doc),
        (name: "coverage", profiles: [Dev, Full, Release], opt_in: Some(Coverage), action: Coverage),
        (name: "package list", profiles: [Full, Release], action: PackageList),
        (name: "package build", profiles: [Full, Release], action: PackageBuild),
        (name: "package provenance", profiles: [Release], action: PackageProvenance),
        (name: "package digest", profiles: [Full, Release], action: PackageDigest),
        (name: "package consumer", profiles: [Full, Release], action: PackageConsumer),
        (name: "code size snapshot", profiles: [Full, Release], action: CodeSizeSnapshot),
        (name: "guards fire on mutation", profiles: [Full, Release], action: GuardSelftest),
        (name: "deny", profiles: [Full, Release], action: Deny),
        (name: "secret scan", profiles: [Full, Release], action: SecretScan),
        (name: "core-only thumbv7em-none-eabi", profiles: [Full, Release], action: CoreOnly(target: "thumb")),
        (name: "core-only riscv32imac-unknown-none-elf", profiles: [Full, Release], action: CoreOnly(target: "riscv")),
        (name: "thumbv7em-none-eabi", profiles: [Full, Release], action: EmbeddedTarget(target: "thumb")),
        (name: "riscv32imac-unknown-none-elf", profiles: [Full, Release], action: EmbeddedTarget(target: "riscv")),
    ],
)
